[Unit]
Description=claude-terminal TTS (local Kokoro-82M text-to-speech for the chat app voice mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=filip
WorkingDirectory=/media/nas/filip/ncdata/filip/files/Projects/claude-terminal/voice/tts
# Kokoro-82M on CPU: first-audio ~0.37s for a short sentence, RTF ~0.18. The app chunks
# Claude's reply by sentence and calls /speak per sentence for low first-audio latency.
# Loopback only — the sidecar proxies + owner-gates it.
Environment=TTS_LANG=a
Environment=TTS_VOICE=af_heart
Environment=TTS_THREADS=8
Environment=HF_HOME=/home/filip/.cache/huggingface
ExecStart=/media/nas/filip/ncdata/filip/files/Projects/claude-terminal/voice/tts/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 7802 --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
