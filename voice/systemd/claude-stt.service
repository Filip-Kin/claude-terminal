[Unit]
Description=claude-terminal STT (local Whisper speech-to-text for the chat app voice mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=filip
WorkingDirectory=/media/nas/filip/ncdata/filip/files/Projects/claude-terminal/voice/stt
# base.en: ~0.4s per short turn on the 5900X, accurate; bump STT_MODEL=small.en for
# more accuracy at ~3x the latency. Loopback only — the sidecar proxies + owner-gates it.
Environment=STT_MODEL=base.en
Environment=STT_DEVICE=cpu
Environment=STT_COMPUTE=int8
Environment=STT_THREADS=8
Environment=HF_HOME=/home/filip/.cache/huggingface
ExecStart=/media/nas/filip/ncdata/filip/files/Projects/claude-terminal/voice/stt/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 7801 --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
