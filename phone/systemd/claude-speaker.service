[Unit]
Description=claude-terminal voiceprint check for the phone bridge (sherpa-onnx TitaNet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=filip
WorkingDirectory=/media/nas/filip/ncdata/filip/files/Projects/claude-terminal/phone/speaker
Environment=PHONE_STATE=/var/lib/claude-phone
Environment=SPEAKER_THREADS=4
# Loopback only: the phone bridge is the one caller.
ExecStart=/media/nas/filip/ncdata/filip/files/Projects/claude-terminal/phone/speaker/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 7803 --log-level warning
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
