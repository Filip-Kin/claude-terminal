#!/bin/bash
# claude-spawn: start a NEW Claude on a given task, detached, as a chat in the claude-terminal
# chat page (/app). It starts working at once and keeps going whether or not anyone looks.
#
# It asks the claude-terminal server to start the chat (POST /sessions/spawn). The server owns
# the one process of that session, so the chat page can be used to read it and to talk to it.
# (Until 2026-11-21 a spawn was a terminal tab in tmux; a message typed for it in the chat page
# started a second process on the same session.)
#
# Usage:
#   claude-spawn --prompt "do the thing" [--name NAME] [--cwd DIR] [--model MODEL]
#   claude-spawn --prompt-file /path/to/prompt.txt [--name NAME] [--cwd DIR]
#
# Options:
#   -p, --prompt TEXT        the task. Required unless --prompt-file is given.
#   -f, --prompt-file FILE   read the prompt from FILE (preferred for long/multi-line
#                            prompts). Use "-" to read stdin.
#   -n, --name NAME          the spawned Claude's display name (what peers see in ListAgents /
#                            a cross-session message header) and its CLAUDE_SPAWNED_TAB.
#                            Sanitised to [A-Za-z0-9_-]. Default: a generated
#                            "spawn-<time>-<rand>" id.
#   -c, --cwd DIR            working directory for the spawned Claude. Default: $PWD.
#   -m, --model MODEL        model alias (opus, sonnet, haiku, fable) or a full id. Omitted
#                            when not given, so the default model is unchanged.
#   -h, --help               this help.
#
# Prints the spawn name on stdout, nothing else.
# Env: CT_SPAWN_URL (default http://127.0.0.1:7682/sessions/spawn), CT_OWNER (the Remote-User
#      the server expects, default: $GUEST_USER in a guest container, else the current user).
set -uo pipefail

die() { echo "claude-spawn: $*" >&2; exit 1; }

name=""
cwd=""
prompt=""
prompt_file=""
model=""

while [ $# -gt 0 ]; do
    case "$1" in
        -n|--name)        name="${2:-}"; shift 2 ;;
        -c|--cwd)         cwd="${2:-}"; shift 2 ;;
        -m|--model)       model="${2:-}"; shift 2 ;;
        -p|--prompt)      prompt="${2:-}"; shift 2 ;;
        -f|--prompt-file) prompt_file="${2:-}"; shift 2 ;;
        -h|--help)        sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)                die "unknown argument: $1 (try --help)" ;;
    esac
done

# Prompt: file (or stdin) wins if given, else the inline string.
if [ -n "$prompt_file" ]; then
    if [ "$prompt_file" = "-" ]; then
        prompt="$(cat)"
    else
        [ -f "$prompt_file" ] || die "prompt file not found: $prompt_file"
        prompt="$(cat "$prompt_file")"
    fi
fi
[ -n "${prompt//[$' \t\n']/}" ] || die "a non-empty --prompt or --prompt-file is required"

# cwd default = caller's cwd; must exist.
[ -n "$cwd" ] || cwd="$PWD"
[ -d "$cwd" ] || die "cwd is not a directory: $cwd"
cwd="$(cd "$cwd" && pwd -P)"

name="${name//[^A-Za-z0-9_-]/}"

url="${CT_SPAWN_URL:-http://127.0.0.1:7682/sessions/spawn}"
owner="${CT_OWNER:-${GUEST_USER:-$(id -un)}}"   # a guest container's server expects the guest's name

# The prompt goes through the environment into json.dumps: no argv limit worth the name, no quoting.
payload="$(CS_PROMPT="$prompt" CS_NAME="$name" CS_CWD="$cwd" CS_MODEL="$model" python3 -c '
import json, os
b = {"prompt": os.environ["CS_PROMPT"], "cwd": os.environ["CS_CWD"]}
if os.environ["CS_NAME"]: b["name"] = os.environ["CS_NAME"]
if os.environ["CS_MODEL"]: b["model"] = os.environ["CS_MODEL"]
print(json.dumps(b))')" || die "could not build the request"

out="$(mktemp)"; trap 'rm -f "$out"' EXIT
code="$(printf '%s' "$payload" | curl -s --max-time 30 -o "$out" -w '%{http_code}' -X POST "$url" \
    -H 'content-type: application/json' -H "Remote-User: $owner" --data-binary @-)" \
    || die "claude-terminal server not reachable at $url"
[ "$code" = "200" ] || die "spawn refused (HTTP $code): $(head -c 300 "$out")"

python3 -c '
import json, sys
d = json.load(open(sys.argv[1]))
# A server from before 2026-11-21 answers {id} only and has started a terminal tab, not a chat.
if not d.get("sessionId"): sys.exit("claude-spawn: server answered without a sessionId: " + json.dumps(d)[:200])
print(d["id"])' "$out"
