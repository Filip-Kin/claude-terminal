# --- Public identity ---
# The canonical, externally reachable base URL. This is BOTH the OAuth issuer and
# the resource-server origin. No trailing slash.
BRIDGE_PUBLIC_URL=https://bridge.filipkin.com
# The MCP endpoint path (the canonical resource identifier is BRIDGE_PUBLIC_URL + this).
BRIDGE_MCP_PATH=/mcp

# --- Listening (behind nginx, plain HTTP on loopback) ---
PORT=7690
HOST=127.0.0.1

# DNS-rebinding guard: comma-separated Host headers we accept (the public host).
BRIDGE_ALLOWED_HOSTS=bridge.filipkin.com

# --- Upstream login: Authelia OIDC (the "homebridge" client) ---
AUTHELIA_ISSUER=https://auth.filipkin.com
AUTHELIA_CLIENT_ID=homebridge
AUTHELIA_CLIENT_SECRET=
# Group a user MUST hold to be allowed through. Enforced server-side as well as
# by the Authelia authorization_policy.
BRIDGE_REQUIRED_GROUP=admins

# --- Our own access-token signing secret (HS256). Persisted to data/secret.key
# on first run if left blank. Rotating it invalidates all issued tokens. ---
BRIDGE_TOKEN_SECRET=
# Access-token lifetime (seconds).
BRIDGE_TOKEN_TTL=3600

# --- Tool roots ---
BRIDGE_MEMORY_DIR=/home/filip/.claude/projects/-home-filip/memory
BRIDGE_FILES_ROOT=/media/nas/filip/ncdata/filip/files

# --- run_claude_task ---
# Set to 0 to disable delegated Claude execution entirely (read-only bridge).
BRIDGE_ENABLE_CLAUDE_TASK=1
BRIDGE_CLAUDE_BIN=/home/filip/.local/bin/claude
# Default working dir for delegated tasks (where ~/.claude memory/context loads from).
BRIDGE_CLAUDE_CWD=/home/filip
# Hard ceiling on a single task, seconds.
BRIDGE_CLAUDE_TIMEOUT=600

# --- Dev only: bypass all auth so /mcp is open on loopback for local testing.
# NEVER set this in production. ---
# BRIDGE_DEV_NO_AUTH=1
